# Copy to .env and adjust. NEVER commit .env (contains secrets).

# --- HTTP ---
PORT=8080

# --- Browser / chromedp ---
HEADLESS=true
CHROME_PATH=
NAV_TIMEOUT=45s
PAGE_LOAD_WAIT=2s

# --- Portals ---
GOVBR_LOGIN_URL=https://sso.acesso.gov.br/login
# DETRAN-RS API host. Empty = https://pcsdetran.procergs.com.br (default).
DETRANRS_URL=

LOGIN_MODE=manual

CHROME_DEBUG_URL=http://localhost:9222

# Protects POST /api/detran/session/token (required when LOGIN_MODE=token).
SESSION_TOKEN_APIKEY=

# --- Observability ---
LOG_LEVEL=info

ANONYMIZE_PII=true
