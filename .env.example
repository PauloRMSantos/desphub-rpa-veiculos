# Copie para .env e ajuste. NUNCA commite o .env (contém segredos).

# --- HTTP ---
PORT=8888

HEADLESS=true
CHROME_PATH=
NAV_TIMEOUT=45s
PAGE_LOAD_WAIT=2s

# --- Portais ---
GOVBR_LOGIN_URL=https://sso.acesso.gov.br/login
# Host da API DETRAN-RS. Vazio = https://pcsdetran.procergs.com.br (default).
DETRANRS_URL=

LOGIN_MODE=manual

CHROME_DEBUG_URL=http://localhost:9222

LOG_LEVEL=info

# --- Privacidade (LGPD) ---
ANONIMIZAR_PII=true
