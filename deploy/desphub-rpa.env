# Configuração do serviço na VPS. Copie para /etc/desphub-rpa.env.
PORT=8080
LOG_LEVEL=info
ANONIMIZAR_PII=true

# --- Login na VPS (headless, sem tela) ---
# A VPS não tem navegador. Opções:
#   token  = a VPS só serve consultas; o token é empurrado de fora (do seu Mac).
#   manual = exige Chrome + Xvfb instalados na VPS (deploy mais pesado).
LOGIN_MODE=token

# Se LOGIN_MODE=manual: onde está o Chrome de depuração (na própria VPS).
# CHROME_DEBUG_URL=http://localhost:9222

# Chave para proteger o endpoint que recebe o token (LOGIN_MODE=token).
# Gere uma aleatória: openssl rand -hex 32
SESSAO_TOKEN_APIKEY=troque-por-uma-chave-secreta
