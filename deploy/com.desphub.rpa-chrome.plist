<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent that starts the Chrome sidecar (remote debugging + persistent
  profile) at user login, so the RPA can connect without anyone opening it by hand.

  Install:
    cp deploy/com.desphub.rpa-chrome.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.desphub.rpa-chrome.plist
  Stop/remove:
    launchctl unload ~/Library/LaunchAgents/com.desphub.rpa-chrome.plist

  Adjust the ProgramArguments path to your project checkout.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.desphub.rpa-chrome</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/paulorosantos/Documents/scrapper/scripts/start-chrome.sh</string>
    </array>

    <!-- Starts at login. Does not auto-restart (the operator controls the window). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/desphub-chrome.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/desphub-chrome.err.log</string>
</dict>
</plist>
