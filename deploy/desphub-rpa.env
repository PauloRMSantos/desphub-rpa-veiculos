# Service configuration on the VPS. Copy to /etc/desphub-rpa.env.
PORT=8080
LOG_LEVEL=info
ANONYMIZE_PII=true

# --- Login on the VPS (headless, no display) ---
# The VPS has no browser. Options:
#   token  = the VPS only serves queries; the token is pushed from outside (your Mac).
#   manual = requires Chrome + Xvfb installed on the VPS (heavier deploy).
LOGIN_MODE=token

# If LOGIN_MODE=manual: where the debug Chrome is (on the VPS itself).
# CHROME_DEBUG_URL=http://localhost:9222

# Key protecting the token-injection endpoint (LOGIN_MODE=token).
# Generate a random one: openssl rand -hex 32
SESSION_TOKEN_APIKEY=replace-with-a-secret-key
